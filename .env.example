# Copy to .env for local testing (never commit .env)

# Anthropic — get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Notion integration token — create at https://www.notion.so/my-integrations
# Grant it access to the pages you want the pipeline to update
NOTION_API_TOKEN=secret_...

# Notion page ID of the root page the pipeline should scan for docs
# (the pipeline will list all child pages under this root)
NOTION_SPACE_PAGE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Set automatically by GitHub Actions — only needed for local testing
GH_TOKEN=ghp_...
COMMIT_SHA=abc1234
REPO=owner/repo
